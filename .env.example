# Environment Variables Template
PORT=5001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://gopartner.in
MONGODB_URI=mongodb://127.0.0.1:27017/go_partner
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# Optional Search Engine & Analytics Integrations
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email Notification Settings (Sends Contact & Quote submissions to contact@gopartnerlogistics.in)
NOTIFICATION_EMAIL=contact@gopartnerlogistics.in
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GO-PARTNER Alerts" <contact@gopartnerlogistics.in>

# Developer & Agency Credit Website
NEXT_PUBLIC_ASH_SOLUTION_URL=https://www.ashsolutions.site/
